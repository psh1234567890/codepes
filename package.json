{
  "name": "codepes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync": "node scripts/monitor-sources.mjs && node scripts/sync-contests.mjs && node scripts/generate-sitemap.mjs",
    "monitor": "node scripts/monitor-sources.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "prebuild": "node scripts/clean-build.mjs && node scripts/generate-sitemap.mjs",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/copy-hosting-metadata.mjs",
    "preview": "vite preview",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
